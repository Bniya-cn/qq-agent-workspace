# ==============================================================================
# QQ Agent 机器人环境配置文件模板 (.env)
# 使用说明：
# 1. 复制本文件为 .env 或 .env.dev：
#    cp .env.example .env.dev
# 2. 根据实际使用的模型服务填写下方的 API 密钥与应用 ID
# 3. 真实密钥请妥善保管，严禁提交到公共 Git 仓库！
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. NoneBot2 核心服务网络配置
# ------------------------------------------------------------------------------
# 运行环境：dev（开发模式，开启热重载与详细日志）或 prod（生产模式）
ENVIRONMENT=dev

# 驱动器：必须包含 ~fastapi，以提供内置 Web 控制面板 (/panel) 与控制器 API 路由
DRIVER=~fastapi

# 机器人服务监听的主机地址与端口（默认 0.0.0.0:8080）
HOST=0.0.0.0
PORT=8080

# 触发命令前缀（数组格式），在群聊中即使不加前缀，@机器人 也可正常唤醒
COMMAND_START=["/"]

# 初始超级管理员 QQ 号（拥有全局免过滤权限与指令控制权，如 1785381042）
SUPERUSER_QQ=

# ------------------------------------------------------------------------------
# 2. OneBot V11 / NapCatQQ 连接配置
# ------------------------------------------------------------------------------
# 反向 WebSocket 鉴权令牌：
# - 若在 NapCat 配置文件中设置了 token / secret，此处必须填写一致的值
# - 本地联调或内网环境下可留空
# - NapCat 端的反向 WebSocket 地址请配置为: ws://127.0.0.1:8080/onebot/v11/ws
ONEBOT_ACCESS_TOKEN=

# ------------------------------------------------------------------------------
# 3. DeepSeek 大语言模型配置（日常闲聊、情绪分析与声音导演）
# ------------------------------------------------------------------------------
# DeepSeek 开放平台 API 基础地址（官方默认: https://api.deepseek.com）
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 日常闲聊模式使用的对话模型（推荐 deepseek-chat 或极速版 deepseek-flash）
DEEPSEEK_MODEL=deepseek-flash

# 声音导演专用大模型（用于按回复台词由 AI 自动推断情绪参考音频）
DEEPSEEK_VOICE_DIRECTOR_MODEL=deepseek-flash

# DeepSeek 平台 API 密钥（获取地址: https://platform.deepseek.com/api_keys）
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# ------------------------------------------------------------------------------
# 4. 阿里云百炼 (DashScope) 干员 RAG 与多模态应用配置
# ------------------------------------------------------------------------------
# 阿里云百炼 API 密钥（获取地址: https://bailian.console.aliyun.com/）
# 同时用于多模态视觉解析、文档生成与生图提示词 Agent
DASHSCOPE_API_KEY=your_dashscope_api_key_here

# 基础通义千问模型（用于文本处理或备用兜底）
DASHSCOPE_MODEL=qwen-plus

# 角色 1：阿米娅（Amiya）百炼应用 ID
# 在百炼控制台创建专属 Agent 应用，挂载 bot/data/knowledge/ 目录下的阿米娅人设与知识库
DASHSCOPE_APP_ID_AMIYA=

# 角色 2：凯尔希（Kal'tsit）百炼应用 ID
# 挂载凯尔希人设及相关医疗档案知识库
DASHSCOPE_APP_ID_KALTSIT=

# 角色 3：通用联网助手百炼应用 ID（可选，用于非人设的实时网络检索）
DASHSCOPE_APP_ID_ASSISTANT=

# 百炼工作流应用 ID（可选，用于执行自定义复杂多步 Agent 任务链）
DASHSCOPE_WORKFLOW_APP_ID=

# 生图提示词专用 Agent 应用 ID（负责将自然语言优化为专业生图 Prompt）
DASHSCOPE_PROMPT_AGENT_APP_ID=

# 图像生成模型名称（默认使用通义万相新一代模型 qwen-image-2.1-pro 或 wanx-v1）
DASHSCOPE_IMAGE_MODEL=qwen-image-2.1-pro

# 多模态视觉理解模型（用于群内识图、图片解析，默认 qwen3-vl-plus 或 qwen-vl-max）
DASHSCOPE_VL_MODEL=qwen3-vl-plus

# ----------------------------------------------------------------------------
# 本机 Apple Silicon 语音识别 (首次启动时按需下载模型到 Hugging Face 缓存)
# ------------------------------------------------------------------------------
ASR_MODEL=mlx-community/whisper-large-v3-turbo-q4
ASR_LANGUAGE=zh

# ------------------------------------------------------------------------------
# 5. GPT-SoVITS 本地语音合成服务（可选）
# ------------------------------------------------------------------------------
# 本地 GPT-SoVITS 推理 API 地址（默认端口 9880，若未启动语音则自动走纯文字回复）
TTS_URL=http://127.0.0.1:9880/tts

# GPT-SoVITS Web 调音台控制地址（默认端口 9876）
STUDIO_URL=http://127.0.0.1:9876

# ------------------------------------------------------------------------------
# 6. 语音情绪与切分性能优化 Feature Flags（默认全部关闭，安全向后兼容）
# ------------------------------------------------------------------------------
# 开启大模型回复前置情绪标签生成提示词（默认 false 关闭）
VOICE_PROMPT_TAG_ENABLED=false

# 开启单一真源情绪标签本地声学路由（默认 false 关闭，关闭时 100% 保持默认基准音色）
VOICE_EMOTION_ROUTING_ENABLED=false

# 开启自适应 cut0 极速切句策略（默认 false 关闭，开启后短句自动使用 cut0）
VOICE_ADAPTIVE_CUT0_ENABLED=false
